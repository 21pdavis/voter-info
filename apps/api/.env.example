# Copy to .env and fill in.

# Port the API listens on locally.
PORT=4000

# Neon Postgres connection string — use the `dev` branch for local work.
# Neon Console -> your project -> Branches -> dev -> Connection Details ->
# pooled connection string (hostname has "-pooler" in it). Leave blank to run
# the API on bundled sample data with no database.
DATABASE_URL=

# Clerk API keys. Clerk dashboard -> API keys.
# Leave blank to run the API with auth disabled (fine for local hello-world).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
