# Copy to .env and fill in.

# Port the API listens on locally.
PORT=4000

# Supabase Postgres connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI.
# Use the "Session pooler" string (port 5432). Leave blank to run the API on
# bundled sample data with no database.
DATABASE_URL=

# Clerk API keys. Clerk dashboard -> API keys.
# Leave blank to run the API with auth disabled (fine for local hello-world).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
