# Copy to .env and fill in. Expo only exposes vars prefixed with EXPO_PUBLIC_.

# Base URL of the API.
#  - iOS simulator / web:            http://localhost:4000
#  - Android emulator:               http://10.0.2.2:4000
#  - Physical phone via Expo Go:     http://<your-computer-LAN-IP>:4000  (e.g. http://192.168.1.20:4000)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Clerk publishable key (only needed once you add sign-in to the app).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
